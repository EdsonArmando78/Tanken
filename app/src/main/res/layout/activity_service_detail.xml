<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/services_title"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationContentDescription="@string/back" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/services_title"
        android:textAppearance="@style/Tanken.Title"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/catalogVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/Tanken.Body" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/services_loading"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/phone"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/service_dial"
        app:icon="@drawable/ic_ms_call"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/email"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/service_email"
        app:icon="@drawable/ic_ms_mail"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/source"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/service_source"
        app:icon="@drawable/ic_ms_open_in_new"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
