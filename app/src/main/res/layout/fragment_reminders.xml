<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminders_intro"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/storageError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_loading"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/notificationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/publication_none"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/permission"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_enable" />
    <com.google.android.material.card.MaterialCardView
        style="@style/Tanken.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <com.google.android.material.textview.MaterialTextView
        android:id="@+id/configTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/configuration_title"
        android:textAppearance="@style/Tanken.Section"
        android:layout_marginBottom="12dp" />
        <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/hydration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/wellness_hydration" />
        <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/hydrationMinutesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hydration_interval"
        android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/hydrationMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:maxLength="3"
        android:singleLine="true"
        android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/breaks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/wellness_break" />
        <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/breakMinutesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/break_interval"
        android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/breakMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:maxLength="3"
        android:singleLine="true"
        android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/classes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/notice_class" />
        <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/classLeadLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/class_lead"
        android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/classLead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:maxLength="3"
        android:singleLine="true"
        android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
        android:id="@+id/daysTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminder_days"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
        <com.google.android.material.chip.ChipGroup
        android:id="@+id/days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false" />
        <com.google.android.material.textview.MaterialTextView
        android:id="@+id/silenceHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/silence_help"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/silenceStart"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/silence_start" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/silenceEnd"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/silence_end" />
        <com.google.android.material.textview.MaterialTextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preferences_invalid"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        style="@style/Tanken.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_save" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/pendingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pending_title"
        android:textAppearance="@style/Tanken.Section"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_loading"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
