<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
  <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/open_about"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationContentDescription="@string/back" />
    <ImageView
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:src="@drawable/tanken_logo"
        android:contentDescription="@string/app_icon_description" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/Tanken.Section"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/project"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_project"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/authors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_authors"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/purpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_purpose"
        android:textAppearance="@style/Tanken.Body"
        android:layout_marginBottom="12dp" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
