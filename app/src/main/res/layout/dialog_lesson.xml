<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical">
        <com.google.android.material.textfield.TextInputLayout
        style="@style/Tanken.TextField"
            android:id="@+id/nameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/schedule_name_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/roomLayout" style="@style/Tanken.TextField"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/schedule_room_hint">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/room" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textCapCharacters" android:maxLength="80" android:singleLine="true"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_days_label"
            android:textAppearance="@style/Tanken.Body" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
            android:fillViewport="true" android:scrollbars="horizontal">
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:singleSelection="false" app:selectionRequired="false">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dayMon" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_mon_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dayTue" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_tue_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dayWed" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_wed_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dayThu" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_thu_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dayFri" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_fri_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/daySat" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:text="@string/schedule_sat_short" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dayHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/schedule_day_required" android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/start"
            style="@style/Tanken.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_start"
        app:icon="@drawable/ic_ms_schedule"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/end"
            style="@style/Tanken.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_end"
        app:icon="@drawable/ic_ms_schedule"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_invalid"
            android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" />
    </LinearLayout>
</ScrollView>
