<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/wellness_title"
            app:titleTextAppearance="@style/Tanken.Section"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:navigationContentDescription="@string/back" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_intro"
            android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" />
        <com.google.android.material.textfield.TextInputLayout
        style="@style/Tanken.TextField"
            android:id="@+id/wellnessIntervalLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wellness_interval">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wellnessInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true"
                android:importantForAutofill="no" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/wellnessInactivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_inactivity_option"
            android:checked="true" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wellnessStart"
            style="@style/Tanken.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_start"
        app:icon="@drawable/ic_ms_science"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wellnessCancel"
            style="@style/Tanken.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_cancel"
        app:icon="@drawable/ic_ms_close"
        app:iconGravity="textStart"
        app:iconSize="20dp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/wellnessProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/wellnessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_ready"
            android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/wellnessResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wellness_ready"
            android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/savedHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comparison_saved"
            android:textAppearance="@style/Tanken.Body"
            android:layout_marginBottom="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
