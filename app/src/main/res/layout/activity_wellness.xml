<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wellnessRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wellness_title" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wellness_intro" android:paddingTop="12dp" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wellness_interval" android:labelFor="@id/wellnessInterval"
            android:paddingTop="16dp" />
        <EditText android:id="@+id/wellnessInterval" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:inputType="number" android:maxLength="3" android:singleLine="true"
            android:text="@string/wellness_default_interval" android:imeOptions="actionDone"
            android:importantForAutofill="no" />
        <CheckBox android:id="@+id/wellnessInactivity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true"
            android:text="@string/wellness_inactivity_option" />
        <Button android:id="@+id/wellnessStart" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/wellness_start" />
        <Button android:id="@+id/wellnessCancel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/wellness_cancel" android:enabled="false" />
        <TextView android:id="@+id/wellnessStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/wellness_ready"
            android:accessibilityLiveRegion="polite" android:textSize="18sp" android:paddingTop="12dp" />
        <ProgressBar android:id="@+id/wellnessProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="3" android:visibility="gone" />
        <Button android:id="@+id/wellnessProbe" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:id="@+id/wellnessResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textIsSelectable="true"
            android:textSize="16sp" android:paddingTop="12dp" />
        <Button android:id="@+id/wellnessBack" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/wellness_back" />
    </LinearLayout>
</ScrollView>
