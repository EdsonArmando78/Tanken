<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp"
    tools:context=".CalculatorActivity">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/calculator_first_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/calculator_second_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <RadioGroup
        android:id="@+id/calcSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:checked="true"
            android:id="@+id/calcAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculator_add" />

        <RadioButton
            android:id="@+id/calcSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculator_subtract" />

        <RadioButton
            android:id="@+id/calcMult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculator_multiply" />

        <RadioButton
            android:id="@+id/calcDiv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculator_divide" />
    </RadioGroup>

    <Button
        android:id="@+id/calcEnter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculator_calculate" />

    <TextView
        style="@style/TextAppearance.Material3.LabelLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculator_result_label" />

    <TextView
        style="@style/TextAppearance.Material3.HeadlineMedium"
        android:id="@+id/calcResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculator_unavailable"/>

</LinearLayout>
